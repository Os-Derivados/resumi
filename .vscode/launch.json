{
	"version": "0.2.0",
	"configurations": [
		{
			"name": "Containers: .NET Attach (Compose)",
			"type": "coreclr",
			"request": "attach",
			// Anexa ao processo 'dotnet' do contêiner
			"processName": "dotnet",
			// Sobe e derruba o stack automaticamente
			"preLaunchTask": "docker-compose: debug",
			"postDebugTask": "docker-compose: down",
			// Executa o vsdbg dentro do contêiner via docker exec
			"pipeTransport": {
				"pipeProgram": "docker",
				"pipeArgs": [
					"exec",
					"-i",
					"resumi"
				],
				"debuggerPath": "/vsdbg/vsdbg",
				"quoteArgs": false
			},
			// Importante: mapeia caminhos de fonte gravados nos PDBs (construídos em /src)
			"sourceFileMap": {
				"/src": "${workspaceFolder}"
			},
			// Ajuste conforme sua CPU no contêiner
			"targetArchitecture": "x86_64",
			// se o contêiner for arm64, use "arm64"
			"logging": {
				"programOutput": true,
				"moduleLoad": false
			},
			"requireExactSource": false,
			"justMyCode": true
		}
	]
}