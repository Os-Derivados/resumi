{
	"version": "2.0.0",
	"tasks": [
		{
			"label": "docker-compose: build",
			"type": "shell",
			"command": "docker compose -f compose.debug.yml build"
		},
		{
			"label": "docker-compose: debug",
			"type": "shell",
			"dependsOn": "docker-compose: build",
			"command": "docker compose -f compose.debug.yml up -d"
		},
		{
			"label": "docker-compose: down",
			"type": "shell",
			"command": "docker compose -f compose.debug.yml down",
			"presentation": {
				"reveal": "never"
			}
		}
	]
}